@* Boton para alternar modo claro / oscuro. Uso: <partial name="_ThemeToggle" model="@("clase-extra")" /> *@
@model string?
<button type="button" class="theme-toggle @Model" data-theme-toggle aria-label="Activar modo oscuro" aria-pressed="false" title="Cambiar tema">
  <i class="bi bi-moon-stars-fill theme-icon-moon" aria-hidden="true"></i>
  <i class="bi bi-sun-fill theme-icon-sun" aria-hidden="true"></i>
</button>
